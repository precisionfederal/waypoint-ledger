# The licence has to READ as a licence. Without an extension Cloudflare Pages
# serves it as application/octet-stream, which makes a browser download the file
# instead of showing it, so counsel gets a mystery blob. /LICENSE.txt and
# /NOTICE.txt exist for the same reason and need no rule.
/LICENSE
  Content-Type: text/plain; charset=utf-8
/NOTICE
  Content-Type: text/plain; charset=utf-8

# The open-data catalog, so a harvester that checks the type is satisfied.
/data.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Next's build chunks carry a content hash in their names, so a URL never
# changes meaning: cache for a year and never revalidate. Without this a
# first-visit reader with no service worker revalidates every chunk on each
# return visit, one round trip apiece. (The security headers are set by
# cf/functions/_middleware.js on every response and are untouched here.)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The fonts keep fixed names, so 30 days rather than immutable. A font file
# whose glyphs change must get a new file name.
/fonts/*
  Cache-Control: public, max-age=2592000

# The walkthrough's captions: a browser only loads a <track> served as text/vtt.
/video/*.vtt
  Content-Type: text/vtt; charset=utf-8
